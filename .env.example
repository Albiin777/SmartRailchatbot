# Backend: custom action service endpoint used by Rasa
RASA_ACTION_ENDPOINT_URL=http://localhost:5055/webhook

# Backend: API used by custom actions to fetch train details
SMART_RAIL_API_BASE_URL=https://smartrail.up.railway.app/api

# Frontend: webhook endpoint used by the React chat UI
VITE_RASA_REST_WEBHOOK_URL=http://localhost:5005/webhooks/rest/webhook

# Optional: used only if Rasa Enterprise channel is enabled
RASA_ENTERPRISE_API_URL=http://localhost:5002/api
